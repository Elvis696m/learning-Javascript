// API CANVAS API
let canvas = document.getElementById('myCanvas');
let context = canvas.getContext('2d');

context.strokeStyle = 'orange'
context.lineWidth = 10;
context.beginPath();
context.moveTo(0, 0);
context.lineTo(250, 250);
context.lineTo(250, 500);
context.moveTo(500, 0);
context.lineTo(250, 250);
context.stroke();
