let timer3 = setTimeout(thirdMessage, 12000)
function firstMessage() {
    alert('please note that you will be driving this car manually! ')
};
function secondMessage() {
    alert('please engage features like difflock to avoid getting stuck')
};
function thirdMessage() {
    alert('GOOD LUCK WITH YOUR DRIVING. SEE YOU ON TOP!')
};
document.getElementById('myButton').onclick = function () {
    clearTimeout(timer1);
    clearTimeout(timer2);
    clearTimeout(timer3);
    alert('YOU WILL BE DIRECTED BACK TO THE HOMESCREEN! CLICK OKAY TO CONTINUE')
};

