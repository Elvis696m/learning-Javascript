// detect key presses
const myDiv = document.getElementById('myDiv');
window.addEventListener('keydown', move);
let x = 0;
let y = 0;
function move(event) {
    switch (event.key) {
        case 'ArrowDown':
            y += 5;
            myDiv.style.top = y + 'px';
            break;

        case 'ArrowUp':
            y -= 5;
            myDiv.style.top = y + 'px';
            break;
        case 'ArrowRight':
            y += 5;
            myDiv.style.left = y + 'px';
            break;
        case 'ArrowLeft':
            y -= 5;
            myDiv.style.left = y + 'px';
            break;
    }
};
