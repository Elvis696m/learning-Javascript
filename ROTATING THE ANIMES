const myButton = document.getElementById('myButton');
const myAnimation = document.getElementById('myDiv');

myButton.addEventListener('click', begin);

function begin() {
    let timerId = null;
    let degrees = 0;
    timerId = setInterval(frame, 20);

    function frame() {
        if (degrees >= 360) {
            clearInterval(timerId)
        }
        else {
            degrees += 1;
            myAnimation.style.transform = 'rotateZ('+degrees+ 'deg)'
        }
    }
}

//If you want to rotate in a circular motion,,use (myAnimation.style.transform = 'rotateZ('+degrees+ 'deg)')
//If you want to rotate in y axis use(myAnimation.style.transform = 'rotateY('+degrees+ 'deg)')
//If you want to rotate in the x axis use(myAnimation.style.transform = 'rotateX('+degrees+ 'deg)')
