//get elements by name 
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">

</head>

<body>
    <h1>THIS IS THE MENU.</h1>
    <input type="radio" name="fruits" value="apple" checked="checked">
    <label for="apple">apple</label><br>
    <input type="radio" name="fruits" value="watermelons" checked="checked">
    <label for="watermelons">watermelons</label><br>
    <input type="radio" name="fruits" value="banana" checked="checked">
    <label for="banana">banana</label><br>
    <script src="index.js"></script>
</body>

</html>


let fruits = document.getElementsByName('fruits');

fruits.forEach(fruit => {
    if (fruit.checked) {
        console.log(fruit.value);
    }
})
