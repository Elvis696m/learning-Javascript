| Keyword | Purpose |
|---|---|
| `try` | Runs code that might produce an error. |
| `catch` | Handles an error if one occurs. |
| `throw` | Deliberately creates an error. |
| `finally` | Runs whether an error occurred or not. |//error
//throw

try {
    let x = window.prompt('ENTER A NUMBER');
    x = Number(x);
    if (isNaN(x)) throw 'That was not a number!'
    if (x == '') throw 'You did not enter a number!'
}

catch (error) {
    console.log(error)
}
