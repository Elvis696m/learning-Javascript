const car1 = {
   model:'Tesla',
   color:'white',
   year:2026,

    drive : function (){
    console.log(`You are driving a ${this.model}`);
    }
}

const car2 ={
    model:'Mustang',
    color:'Red',
    year:2023,


    drive : function (){
    console.log(`You are driving a ${this.model}`);
    }
}
