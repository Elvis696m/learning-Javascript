// static=belongs to a class,useful for caches.

class car{

    numberOfCars = 0;
    constructor(model){
        this.model = model;
        this.numberOfCars +=1;
    }
}

const car1 = new car('Mustang');
const car2 =  new car('Mazda');
const car3 = new car('BMW');
console.log(car1.numberOfCars);
console.log(car2.numberOfCars);
console.log(car3.numberOfCars);
