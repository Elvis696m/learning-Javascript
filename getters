class Car {
    constructor(power) {
        this._power = power;
        this._gas = 5;
    }
    get power() {
        return `${this._power}hp`;
    }
    get gas(){
        return `${this._gas}gallons (${this._gas/50*100}%)`;
    }
}

let car=new Car(400);
console.log(car.gas);
console.log(car.power);
